# LLM Backend: "vllm" (local) or "openai" (remote)
LLM_BACKEND=vllm

# LLM model name
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_TEMPERATURE=0.0

# vLLM settings (used when LLM_BACKEND=vllm)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_PATH=/workspace/models/Qwen2.5-0.5B-Instruct
VLLM_MAX_MODEL_LEN=2048

# OpenAI settings (used when LLM_BACKEND=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Qdrant (leave empty for in-memory mode)
QDRANT_URL=
QDRANT_API_KEY=

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=advanced_rag

# RAG pipeline
MAX_RETRIEVAL_DOCS=5
MAX_RETRIES=3
MULTI_QUERY=false
USE_PARENT_CHILD_CHUNKING=true
RERANKER_BACKEND=none
RERANK_TOP_K=5

# Vector store backend: qdrant | pgvector
VECTOR_BACKEND=qdrant

# Optional API key (leave empty to disable auth)
API_KEY=

# Judge LLM overrides (optional; defaults to main LLM settings)
JUDGE_LLM_BACKEND=
JUDGE_LLM_MODEL=
JUDGE_LLM_TEMPERATURE=0.0
JUDGE_VLLM_BASE_URL=

# Redis (ARQ async ingest; leave empty for sync-only)
REDIS_URL=
# Set true to enqueue POST /documents instead of blocking
INGEST_QUEUE_ASYNC=false
# ARQ queue name (must match worker)
ARQ_QUEUE_NAME=arq:queue
